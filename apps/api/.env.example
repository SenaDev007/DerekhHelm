# API Travel Helm — variables d'environnement
# (copier vers .env pour le développement local ; sur Vercel, configurer dans le projet)

# Base de données (développement : SQLite ; production : PostgreSQL)
DATABASE_URL=file:../../db/custom.db

# Secrets (obligatoires en production)
HELM_QR_SECRET=change-me-qr-secret
HELM_SESSION_SECRET=change-me-session-secret

# Port local
API_PORT=4000

# Mode démonstration (comptes visibles sur l'écran de connexion) : 1 = activé
HELM_DEMO=1

# Journalisation des requêtes : 0 pour désactiver
HELM_LOG=1
