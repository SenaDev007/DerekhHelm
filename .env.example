# ————————————————————————————————————————————————————————————————
# Travel Helm — variables d'environnement
# Copiez ce fichier en .env à la racine, puis adaptez.
# ————————————————————————————————————————————————————————————————

# Base de données.
#  · Développement local : SQLite (fichier)
DATABASE_URL=file:./db/custom.db
#  · Production (Vercel) : PostgreSQL managé (Neon, Supabase…)
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secret de signature des billets QR (obligatoire en production — générez une valeur aléatoire longue).
HELM_QR_SECRET=change-me-qr-secret

# Secret de signature des sessions back-office (obligatoire en production).
HELM_SESSION_SECRET=change-me-session-secret

# Ports locaux de développement
API_PORT=4000
WEB_PORT=3000

# Mode démonstration : expose les comptes de démo sur l'écran de connexion.
# Mettre 0 ou supprimer en production.
HELM_DEMO=1
